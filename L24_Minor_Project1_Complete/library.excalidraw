      "isDeleted": false,
      "boundElements": null,
      "updated": 1778316541663,
      "link": null,
      "locked": false,
      "text": "O1 --> S1 <=> B1  (10th May - 25th May) Issue Request\nO2 --> S1 <=> B1  Return Request\nO3 --> S1 <=> B1  (25th May - 9th June) Issue Request\n...",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O1 --> S1 <=> B1  (10th May - 25th May) Issue Request\nO2 --> S1 <=> B1  Return Request\nO3 --> S1 <=> B1  (25th May - 9th June) Issue Request\n...",
      "autoResize": true,
      "lineHeight": 1.25
    },
