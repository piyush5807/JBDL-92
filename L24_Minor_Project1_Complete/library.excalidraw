  "elements": [
    {
      "id": "EHqpKB5BCeti2ZJyprN1a",
      "type": "text",
      "x": 2375.4677718827297,
      "y": 2716.9947161662976,
      "width": 1692.6829833984375,
      "height": 980,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2W",
      "roundness": null,
      "seed": 1912650712,
      "version": 986,
      "versionNonce": 1793293978,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778315722769,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n1. Users should be able to see profiles based on preferences and location\n2. Users should be able to swipe like / dislike a profile\n3. System should be matching people who liked each other\n4. Users should be see their matches\n\n--- \nOut of scope \n5. People should be able to send messages to their matches\n\nNon-Functional Requirements:\n1. 1M+ DAU, so users should be able to see the matching profiles quickly ( < 200 ms)\n2. Availability >> Consistency (New matching profiles, i.e if a new profile do not arrive in the feed instantaneously it's okay)\n\n\nCore Entity\n\n1. User\n2. User Match Actions\n3. Match\n\n\nAPIs \n\nGET /profiles?\n\nPOST /swipe\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n1. Users should be able to see profiles based on preferences and location\n2. Users should be able to swipe like / dislike a profile\n3. System should be matching people who liked each other\n4. Users should be see their matches\n\n--- \nOut of scope \n5. People should be able to send messages to their matches\n\nNon-Functional Requirements:\n1. 1M+ DAU, so users should be able to see the matching profiles quickly ( < 200 ms)\n2. Availability >> Consistency (New matching profiles, i.e if a new profile do not arrive in the feed instantaneously it's okay)\n\n\nCore Entity\n\n1. User\n2. User Match Actions\n3. Match\n\n\nAPIs \n\nGET /profiles?\n\nPOST /swipe\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
