    {
      "id": "LBQ2yjyhNo9IQ4WszVBrM",
      "type": "text",
      "x": 1808.5235909117762,
      "y": 2063.937358068729,
      "width": 1284.723388671875,
      "height": 805,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 190971785,
      "version": 1000,
      "versionNonce": 264743591,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1777799201304,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. List of ads to be shown to the end user\n2. Users should be able to click on the ad.\n3. Client app should be able to fetch the details of an ad\n\nOut of the scope\n3. API to create an add in the system.\n4. Capability to add a campaign and attach ads to a campaign\n\n\nNon-Functional Requirements\n1. Scale (1M+ clicks per seconds on ads ). Latency of clicking on ad should be very less (<200)\n2. Ad click behaviour (Availability >> Consistency)\n\n\n\nCore Entities\n\n1. Ad\n\n2. User\n\n3. Click",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. List of ads to be shown to the end user\n2. Users should be able to click on the ad.\n3. Client app should be able to fetch the details of an ad\n\nOut of the scope\n3. API to create an add in the system.\n4. Capability to add a campaign and attach ads to a campaign\n\n\nNon-Functional Requirements\n1. Scale (1M+ clicks per seconds on ads ). Latency of clicking on ad should be very less (<200)\n2. Ad click behaviour (Availability >> Consistency)\n\n\n\nCore Entities\n\n1. Ad\n\n2. User\n\n3. Click",
      "autoResize": true,
      "lineHeight": 1.25
    },
