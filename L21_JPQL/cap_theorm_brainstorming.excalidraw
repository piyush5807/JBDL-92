      "id": "o7K4jkZAMDttFY0-ItEh3",
      "type": "text",
      "x": 1172.8993121935273,
      "y": -2214.258654084666,
      "width": 1659.5029296875,
      "height": 1295,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1440833812,
      "version": 976,
      "versionNonce": 734957705,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1777799201304,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n1. Users should be able to view their own news feed which should consist of posts coming from their subscribed channels.\n2. User should be able to subscribe to news channels / pages\n3. User should be able to view a post from their feed \n \n\n\nNon-Functional Requirements:\n1. 100M+ DAU, 1M+ rps for retrieving news feed\n2. Availability >> Consistency news feed\n3. latency < 500ms\n\n\n\nCore Entities\n\n1. NewsFeed\n2. User\n3. Post\n\n\nAPI / Interface\n\nPOST /channel/:channelId/subscribe\n{\n    userId -- from token\n}\n\nGET /newsfeed. --> Post[]\n{\n    userId -- from token\n}\n\nGET /news/:newsId --> Post\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n1. Users should be able to view their own news feed which should consist of posts coming from their subscribed channels.\n2. User should be able to subscribe to news channels / pages\n3. User should be able to view a post from their feed \n \n\n\nNon-Functional Requirements:\n1. 100M+ DAU, 1M+ rps for retrieving news feed\n2. Availability >> Consistency news feed\n3. latency < 500ms\n\n\n\nCore Entities\n\n1. NewsFeed\n2. User\n3. Post\n\n\nAPI / Interface\n\nPOST /channel/:channelId/subscribe\n{\n    userId -- from token\n}\n\nGET /newsfeed. --> Post[]\n{\n    userId -- from token\n}\n\nGET /news/:newsId --> Post\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
